<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<StackPane fx:id="rootPane" prefHeight="600" prefWidth="900" style="-fx-background-color: #050a1a;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.codeplayfx.ui.controller.GalleryController">

    <!-- ═══════════════════════════════════════════════════
         BACKGROUND LAYERS (SAME AS WELCOME & LIBRARY)
    ════════════════════════════════════════════════════ -->

    <!-- LAYER 0 — Dark gradient background -->
    <Pane fx:id="bgPane" prefHeight="600" prefWidth="900" style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #050a1a 0%, #0d0824 40%, #110a30 70%, #000408 100%);" />

    <!-- LAYER 1 — Grid overlay (lines drawn in controller) -->
    <Pane fx:id="gridPane" mouseTransparent="true" opacity="0.045" prefHeight="600" prefWidth="900" />

    <!-- LAYER 2 — Particle canvas (AnimationTimer in controller) -->
    <Canvas fx:id="particleCanvas" height="600" mouseTransparent="true" width="900" />

    <!-- LAYER 3 — Ambient glow orbs (added in controller) -->
    <Pane fx:id="orbPane" mouseTransparent="true" prefHeight="600" prefWidth="900" />

    <!-- ═══════════════════════════════════════════════════
         LAYER 4 — GALLERY CONTENT
    ════════════════════════════════════════════════════ -->
    <BorderPane fx:id="contentBorderPane" prefHeight="600" prefWidth="900" style="-fx-background-color: transparent;">

        <!-- TOP BAR - Navigation buttons (identical to Library) -->
        <top>
            <HBox alignment="CENTER_LEFT" prefHeight="81.0" prefWidth="900.0" spacing="10" style="-fx-padding: 15 20;">
                <Text style="-fx-font-family: 'Arial Black'; -fx-font-size: 29px; -fx-fill: rgba(220,230,255,0.9);" text="PROJECTS" />

                <Button fx:id="backButton" onAction="#goBack" prefHeight="45.0" prefWidth="95.0" styleClass="transparent-button" text="← BACK" />
                <Button fx:id="mainWindowButton" onAction="#goMainWindow" prefHeight="45.0" prefWidth="95.0" styleClass="transparent-button" text="EDITOR" />
                <Button fx:id="libraryButton" onAction="#goLibrary" prefHeight="45.0" prefWidth="95.0" styleClass="transparent-button" text="LIBRARY" />
                <Button fx:id="aboutButton" onAction="#goAbout" prefHeight="45.0" prefWidth="95.0" styleClass="transparent-button" text="ABOUT" />
                <Button fx:id="homeButton" onAction="#goHome" prefHeight="45.0" prefWidth="95.0" styleClass="transparent-button" text="HOME" />
            </HBox>
        </top>

        <!-- LEFT SPACER -->
        <left>
            <VBox prefWidth="30.0" />
        </left>

        <!-- RIGHT SPACER -->
        <right>
            <VBox prefWidth="30.0" />
        </right>

        <!-- BOTTOM SPACER -->
        <bottom>
            <HBox prefHeight="20.0" />
        </bottom>

        <!-- CENTER - Gallery Content with Split View -->
        <center>
            <BorderPane style="-fx-background-color: transparent;">

                <!-- Top tools -->
                <top>
                    <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 10 0 15 0;">
                        <TextField fx:id="searchField" promptText="🔍 Search projects..." styleClass="gallery-search" HBox.hgrow="ALWAYS" />
                        <Button fx:id="importButton" styleClass="gallery-action-button" text="📂 IMPORT" />
                        <Button fx:id="refreshButton" styleClass="gallery-action-button" text="🔄 REFRESH" />
                    </HBox>
                </top>

                <!-- Center content - Split pane with list and preview -->
                <center>
                    <SplitPane dividerPositions="0.3560171919770773" style="-fx-background-color: transparent;">

                        <!-- LEFT: Projects List -->
                        <VBox spacing="10" style="-fx-background-color: rgba(20, 15, 30, 0.6); -fx-background-radius: 10; -fx-padding: 10;">
                            <Label style="-fx-text-fill: #03edf9; -fx-font-weight: bold; -fx-font-size: 16px;" text="Your Projects" />
                            <ListView fx:id="projectListView" styleClass="gallery-list" VBox.vgrow="ALWAYS" />
                            <HBox alignment="CENTER" spacing="10">
                                <Button fx:id="deleteButton" disable="true" styleClass="gallery-danger-button" text="🗑 DELETE" />
                            </HBox>
                        </VBox>

                        <!-- RIGHT: Preview Area -->
                        <VBox spacing="10" style="-fx-background-color: rgba(30, 20, 40, 0.6); -fx-background-radius: 10; -fx-padding: 15;">

                            <!-- Project Info -->
                            <Label fx:id="projectInfoLabel" style="-fx-text-fill: #ffb3ff; -fx-font-size: 14px;" text="Select a project to preview" />

                            <!-- Tab Pane for Code and Documentation -->
                            <TabPane styleClass="gallery-tab-pane" VBox.vgrow="ALWAYS">

                                <!-- Code Tab -->
                                <Tab closable="false" text="&lt;/&gt; CODE">
                                    <TextArea fx:id="codePreviewArea" editable="false" styleClass="gallery-preview" wrapText="true" />
                                </Tab>

                                <!-- Documentation Tab -->
                                <Tab closable="false" text="📝 DOCUMENTATION">
                                    <TextArea fx:id="docPreviewArea" editable="false" styleClass="gallery-preview" wrapText="true" />
                                </Tab>

                            </TabPane>

                            <!-- Action Buttons -->
                            <HBox alignment="CENTER" spacing="15" style="-fx-padding: 10 0 0 0;">
                                <Button fx:id="loadButton" disable="true" styleClass="gallery-primary-button" text=" LOAD PROJECT" />
                                <Button fx:id="exportButton" disable="true" styleClass="gallery-secondary-button" text="💾 EXPORT" />
                            </HBox>

                        </VBox>
                    </SplitPane>
                </center>

                <!-- Bottom status -->
                <bottom>
                    <HBox style="-fx-padding: 10 0 0 0;">
                        <Label fx:id="statusLabel" style="-fx-text-fill: #888; -fx-font-size: 11px;" />
                    </HBox>
                </bottom>

            </BorderPane>
        </center>

    </BorderPane>
</StackPane>
