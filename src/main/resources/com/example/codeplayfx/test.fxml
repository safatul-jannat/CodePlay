<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<StackPane fx:id="rootPane" prefHeight="600" prefWidth="900" style="-fx-background-color: #050a1a;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.codeplayfx.ui.controller.AboutController">

    <!-- BACKGROUND LAYERS -->
    <Pane fx:id="bgPane" prefHeight="600" prefWidth="900" style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #050a1a 0%, #0d0824 40%, #110a30 70%, #000408 100%);" />
    <Pane fx:id="gridPane" mouseTransparent="true" opacity="0.045" prefHeight="600" prefWidth="900" />
    <Canvas fx:id="particleCanvas" height="600" mouseTransparent="true" width="900" />
    <Pane fx:id="orbPane" mouseTransparent="true" prefHeight="600" prefWidth="900" />

    <!-- CONTENT -->
    <BorderPane fx:id="contentBorderPane" prefHeight="600" prefWidth="900" style="-fx-background-color: transparent;">

        <!-- TOP BAR -->
        <top>
            <HBox alignment="CENTER_LEFT" prefHeight="81.0" prefWidth="900.0" spacing="10" style="-fx-padding: 15 20;">
                <Text style="-fx-font-family: 'Arial Black'; -fx-font-size: 29px; -fx-fill: rgba(220,230,255,0.9);" text="ABOUT" />
                <Button fx:id="backButton" onAction="#goBack" prefHeight="45.0" prefWidth="95.0" text="← BACK" />
                <Button fx:id="mainWindowButton" onAction="#goMainWindow" prefHeight="45.0" prefWidth="95.0" text="EDITOR" />
                <Button fx:id="galleryButton" onAction="#goGallery" prefHeight="46.0" prefWidth="116.0" text="PROJECTS" />
                <Button fx:id="libraryButton" onAction="#goLibrary" prefHeight="45.0" prefWidth="95.0" text="LIBRARY" />
                <Button fx:id="homeButton" onAction="#goHome" prefHeight="45.0" prefWidth="95.0" text="HOME" />
            </HBox>
        </top>

        <!-- CENTER - Simple about content -->
        <center>
            <VBox alignment="CENTER" spacing="25" style="-fx-padding: 40;">

                <!-- App Logo -->
                <VBox alignment="CENTER" spacing="10">
                    <Text style="-fx-font-family: 'Arial Black'; -fx-font-size: 64px; -fx-fill: linear-gradient(from 0% 0% to 100% 100%, #88aaff, #ff6ec7);" text="CodePlay" />
                    <Text style="-fx-font-family: 'Arial'; -fx-font-size: 16px; -fx-fill: rgba(220,230,255,0.7);" text="OOP Based Gaming Platform" />
                    <Label style="-fx-text-fill: #666; -fx-font-size: 12px;" text="Version 1.0.0" />
                </VBox>

                <!-- Description -->
                <VBox alignment="CENTER" spacing="15" style="-fx-max-width: 600;">
                    <Text style="-fx-font-family: 'Arial'; -fx-font-size: 14px; -fx-fill: #cccccc; -fx-text-alignment: center;" text="CodePlay is an interactive gaming platform that teaches Object-Oriented Programming concepts through hands-on gameplay. Create, explore, and learn Java OOP principles in a fun and engaging environment."/>
                </VBox>

                <!-- Team -->
                <VBox alignment="CENTER" spacing="15">
                    <Text style="-fx-font-family: 'Arial Black'; -fx-font-size: 18px; -fx-fill: #ff6ec7;" text="Development Team" />
                    <VBox alignment="CENTER" spacing="8">
                        <Text style="-fx-font-family: 'Arial'; -fx-font-size: 14px; -fx-fill: #88aaff;" text="Mst. Safatul Jannat Shupti" />
                        <Text style="-fx-font-family: 'Arial'; -fx-font-size: 14px; -fx-fill: #03edf9;" text="Safia Tasnim" />
                        <Text style="-fx-font-family: 'Arial'; -fx-font-size: 14px; -fx-fill: #ffb3ff;" text="Tuzana Shahrin Arna" />
                    </VBox>
                </VBox>

                <!-- Tech Stack -->
                <VBox alignment="CENTER" spacing="10">
                    <Text style="-fx-font-family: 'Arial Black'; -fx-font-size: 18px; -fx-fill: #03edf9;" text="Built With" />
                    <HBox alignment="CENTER" spacing="20">
                        <Label style="-fx-text-fill: #88aaff; -fx-font-size: 13px;" text="Java 25" />
                        <Label style="-fx-text-fill: #ff6ec7; -fx-font-size: 13px;" text="JavaFX 21" />
                        <Label style="-fx-text-fill: #03edf9; -fx-font-size: 13px;" text="Maven" />
                    </HBox>
                </VBox>

                <!-- Footer -->
                <Label style="-fx-text-fill: #555; -fx-font-size: 11px; -fx-padding: 20 0 0 0;" text="© 2024 CodePlay - Learn OOP Through Gaming" />

            </VBox>
        </center>

    </BorderPane>
</StackPane>