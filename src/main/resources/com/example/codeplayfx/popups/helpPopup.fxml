<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="500.0" prefWidth="450.0" spacing="10"
      style="-fx-background-color: #2a0c4a; -fx-border-color: #5905f5; -fx-border-width: 1.5; -fx-background-radius: 10; -fx-border-radius: 10;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.codeplayfx.ui.popup.HelpPopupController">
    <padding>
        <Insets bottom="15" left="15" right="15" top="15" />
    </padding>

    <Label style="-fx-text-fill: #ff6ec7; -fx-font-weight: bold; -fx-font-size: 18px;" text="❓ How to Use CodePlay" />

    <ScrollPane fitToWidth="true" prefHeight="400.0" style="-fx-background: #1a0b2e; -fx-background-color: #1a0b2e;">
        <VBox spacing="15" style="-fx-background-color: #1a0b2e; -fx-padding: 10;">

            <!-- SECTION 1: Run / Stop -->
            <VBox spacing="5">
                <Label style="-fx-text-fill: #00f7ff; -fx-font-weight: bold; -fx-font-size: 14px;" text="▶  Running Your Game" />
                <Label wrapText="true" style="-fx-text-fill: #cccccc;"
                       text="Click the ▶ Run button in the toolbar to start your game." />
                <Label wrapText="true" style="-fx-text-fill: #ffaa00;"
                       text="⚠  While the game is running, the code editor is locked — you cannot type or make changes." />
                <Label wrapText="true" style="-fx-text-fill: #cccccc;"
                       text="To edit your code again: click ■ Stop, make your changes, then click ▶ Run again." />
            </VBox>

            <Separator style="-fx-background-color: #5905f5;" />

            <!-- SECTION 2: show() is required -->
            <VBox spacing="5">
                <Label style="-fx-text-fill: #00f7ff; -fx-font-weight: bold; -fx-font-size: 14px;" text="👁  Always Call show()" />
                <Label wrapText="true" style="-fx-text-fill: #cccccc;"
                       text="Creating an object does NOT make it appear on screen. You must call .show() or nothing will be visible." />
                <Label style="-fx-text-fill: #cccccc; -fx-font-family: 'Monospace';"
                       text="player = new BlockPlayer(5, 5);&#10;player.show();  // ← required!" />
            </VBox>

            <Separator style="-fx-background-color: #5905f5;" />

            <!-- SECTION 3: execute() runs every frame -->
            <VBox spacing="5">
                <Label style="-fx-text-fill: #00f7ff; -fx-font-weight: bold; -fx-font-size: 14px;" text="⚠  execute() Runs Every Frame" />
                <Label wrapText="true" style="-fx-text-fill: #cccccc;"
                       text="execute() is called ~60 times per second. Without a null check, a new object spawns every frame and the game will crash or lag." />
                <Label wrapText="true" style="-fx-text-fill: #ffaa00;" text="Always guard your object creation like this:" />
                <Label style="-fx-text-fill: #cccccc; -fx-font-family: 'Monospace';"
                       text="if (player == null) {&#10;    player = new BlockPlayer(5, 5);&#10;    player.show();&#10;}" />
            </VBox>

            <Separator style="-fx-background-color: #5905f5;" />

            <!-- SECTION 4: Background -->
            <VBox spacing="5">
                <Label style="-fx-text-fill: #00f7ff; -fx-font-weight: bold; -fx-font-size: 14px;" text="🎨  Setting a Background" />
                <Label wrapText="true" style="-fx-text-fill: #cccccc;"
                       text="Use setBackground() to set a background color. If you call it every frame without clearing first, backgrounds will stack up." />
                <Label wrapText="true" style="-fx-text-fill: #ffaa00;" text="Always pair them:" />
                <Label style="-fx-text-fill: #cccccc; -fx-font-family: 'Monospace';"
                       text="clearBackground();&#10;setBackground(&quot;darkblue&quot;);" />
                <Label wrapText="true" style="-fx-text-fill: #cccccc;"
                       text="If your background only needs to be set once, put it inside the null check so it only runs at startup." />
            </VBox>

            <Separator style="-fx-background-color: #5905f5;" />

            <!-- SECTION 5: Gravity -->
            <VBox spacing="5">
                <Label style="-fx-text-fill: #00f7ff; -fx-font-weight: bold; -fx-font-size: 14px;" text="🌍  Gravity is ON by Default" />
                <Label wrapText="true" style="-fx-text-fill: #cccccc;"
                       text="Your player will fall as soon as the game starts. For top-down or puzzle games, turn gravity off:" />
                <Label style="-fx-text-fill: #cccccc; -fx-font-family: 'Monospace';"
                       text="setGravity(false);" />
                <Label wrapText="true" style="-fx-text-fill: #cccccc;" text="Or adjust the gravity strength:" />
                <Label style="-fx-text-fill: #cccccc; -fx-font-family: 'Monospace';"
                       text="setGravity(0.3f);  // weaker gravity" />
            </VBox>

            <Separator style="-fx-background-color: #5905f5;" />

            <!-- SECTION 6: Key names -->
            <VBox spacing="5">
                <Label style="-fx-text-fill: #00f7ff; -fx-font-weight: bold; -fx-font-size: 14px;" text="⌨  Key Names Are Strings" />
                <Label wrapText="true" style="-fx-text-fill: #cccccc;"
                       text="Pass key names as text strings — not characters or numbers:" />
                <Label style="-fx-text-fill: #cccccc; -fx-font-family: 'Monospace';"
                       text="isKeyPressed(&quot;LEFT&quot;)&#10;isKeyPressed(&quot;RIGHT&quot;)&#10;isKeyPressed(&quot;SPACE&quot;)&#10;isKeyPressed(&quot;W&quot;) / &quot;A&quot; / &quot;S&quot; / &quot;D&quot;" />
            </VBox>

            <Separator style="-fx-background-color: #5905f5;" />

            <!-- SECTION 7: Enemies -->
            <VBox spacing="5">
                <Label style="-fx-text-fill: #00f7ff; -fx-font-weight: bold; -fx-font-size: 14px;" text="👾  Setting Up Enemies" />
                <Label wrapText="true" style="-fx-text-fill: #cccccc;"
                       text="Set the enemy's movement pattern and bounds BEFORE calling show(), otherwise it won't move:" />
                <Label style="-fx-text-fill: #cccccc; -fx-font-family: 'Monospace';"
                       text="enemy.setPattern(Enemy.Pattern.STRAIGHT);&#10;enemy.setBounds(3, 12);&#10;enemy.show();" />
                <Label wrapText="true" style="-fx-text-fill: #cccccc;"
                       text="Collision damage is automatic. When an enemy touches the player, damage is applied with no extra code needed." />
            </VBox>

            <Separator style="-fx-background-color: #5905f5;" />

            <!-- SECTION 8: Library -->
            <VBox spacing="5">
                <Label style="-fx-text-fill: #00f7ff; -fx-font-weight: bold; -fx-font-size: 14px;" text="📚  Learning About Objects" />
                <Label wrapText="true" style="-fx-text-fill: #cccccc;"
                       text="For full documentation on BlockPlayer, Enemy, and all available objects and their methods, click the Library button in the toolbar." />
                <Label wrapText="true" style="-fx-text-fill: #ffaa00;"
                       text="The Library is your main reference — this Help panel is just for understanding how the app works." />
            </VBox>

        </VBox>
    </ScrollPane>

    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="closeButton"
                onAction="#handleClose"
                text="Close"
                style="-fx-background-color: #ff6ec7; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 30; -fx-cursor: hand;" />
    </HBox>
</VBox>