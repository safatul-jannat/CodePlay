<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="500.0" prefWidth="450.0" spacing="10"
      style="-fx-background-color: #2a0c4a; -fx-border-color: #5905f5; -fx-border-width: 1.5; -fx-background-radius: 10; -fx-border-radius: 10;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.codeplayfx.ui.popup.HelpPopupController">
    <padding>
        <Insets bottom="15" left="15" right="15" top="15" />
    </padding>

    <Label style="-fx-text-fill: #ff6ec7; -fx-font-weight: bold; -fx-font-size: 18px;" text="❓ How to Create a Game" />

    <ScrollPane fitToWidth="true" prefHeight="400.0" style="-fx-background: #1a0b2e; -fx-background-color: #1a0b2e;">
        <VBox spacing="15" style="-fx-background-color: #1a0b2e; -fx-padding: 10;">

            <VBox spacing="5">
                <Label style="-fx-text-fill: #00f7ff; -fx-font-weight: bold; -fx-font-size: 14px;" text="📌 Step 1: Create a Class" />
                <Label style="-fx-text-fill: #cccccc; -fx-font-family: 'Monospace';"
                       text="public class MyGame extends UserGame {\n    // Your code here\n}" />
            </VBox>

            <Separator style="-fx-background-color: #5905f5;" />

            <VBox spacing="5">
                <Label style="-fx-text-fill: #00f7ff; -fx-font-weight: bold; -fx-font-size: 14px;" text="📌 Step 2: Create a Player" />
                <Label style="-fx-text-fill: #cccccc; -fx-font-family: 'Monospace';"
                       text="BlockPlayer player;\n\npublic void execute() {\n    if (player == null) {\n        player = new BlockPlayer(5, 5);\n        player.show();\n    }\n}" />
            </VBox>

            <Separator style="-fx-background-color: #5905f5;" />

            <VBox spacing="5">
                <Label style="-fx-text-fill: #00f7ff; -fx-font-weight: bold; -fx-font-size: 14px;" text="📌 Step 3: Add Controls" />
                <Label style="-fx-text-fill: #cccccc; -fx-font-family: 'Monospace';"
                       text="if (isKeyPressed('RIGHT')) {\n    player.moveRight();\n}\nif (isKeyPressed('LEFT')) {\n    player.moveLeft();\n}\nif (isKeyPressed('SPACE')) {\n    player.jump();\n}" />
            </VBox>

            <Separator style="-fx-background-color: #5905f5;" />

            <VBox spacing="5">
                <Label style="-fx-text-fill: #00f7ff; -fx-font-weight: bold; -fx-font-size: 14px;" text="📌 Step 4: Run Your Game" />
                <Label style="-fx-text-fill: #cccccc;"
                       text="Click the '▶ Run' button in the top toolbar to start your game!" />
            </VBox>

            <Separator style="-fx-background-color: #5905f5;" />

            <VBox spacing="5">
                <Label style="-fx-text-fill: #00f7ff; -fx-font-weight: bold; -fx-font-size: 14px;" text="🎮 Available Methods" />
                <Label style="-fx-text-fill: #ffaa00;" text="Movement:" />
                <Label style="-fx-text-fill: #cccccc;" text="  • moveRight(), moveLeft()" />
                <Label style="-fx-text-fill: #cccccc;" text="  • moveUp(), moveDown()" />
                <Label style="-fx-text-fill: #cccccc;" text="  • jump()" />

                <Label style="-fx-text-fill: #ffaa00;" text="Input:" />
                <Label style="-fx-text-fill: #cccccc;" text="  • isKeyPressed('W') - check if key pressed" />
                <Label style="-fx-text-fill: #cccccc;" text="  • getMouseX(), getMouseY() - mouse position" />

                <Label style="-fx-text-fill: #ffaa00;" text="Gravity:" />
                <Label style="-fx-text-fill: #cccccc;" text="  • setGravity(true/false) - toggle gravity" />
                <Label style="-fx-text-fill: #cccccc;" text="  • setGravity(0.8) - set gravity strength" />
            </VBox>
        </VBox>
    </ScrollPane>

    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="closeButton"
                onAction="#handleClose"
                text="Close"
                style="-fx-background-color: #ff6ec7; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 30; -fx-cursor: hand;" />
    </HBox>
</VBox>